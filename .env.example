ATMEE_BASE_URL=https://staging.atmanity.us
ATMEE_API_KEY=sk_atmee_...
MAX_SECONDS=900
PORT=3333
GEMINI_API_KEY=...
# One staging avatar per app, each made for its role (persona and voice).
AVATAR_LIVESTREAM=a82b610a-3e64-46c9-b7a5-a17e4b0cf910
AVATAR_GAME=52b385d0-4a0a-425d-b7b4-02ded2fdefb2
AVATAR_RECRUITER=09f028eb-f9f1-4565-8fc8-a3e2cd17697c
AVATAR_TRAINING=215ab2d3-9b99-4530-99ec-7d2e87ef7b14
AVATAR_PRESENCE=cf542ef0-88d6-4b6c-adce-c0f491a95acf

# The fourteen mini-apps (apps/<id> with a server.ts) run in the same server as the five
# (npm run dev, every app on SITE_PORT). Each one's host is the avatarId in
# apps/<id>/avatar.json, an avatar of the same account as the five's: one key for all.
SITE_PORT=5190
# AVATAR_<APP_ID> overrides one app's host, e.g. AVATAR_CHESS_OPPONENT=...;
# AVATAR_DEFAULT serves an app that has neither.
# AVATAR_DEFAULT=
# Notch's catalogue images (optional).
# XAI_API_KEY=
