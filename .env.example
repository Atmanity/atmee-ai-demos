ATMEE_BASE_URL=https://staging.atmanity.us
ATMEE_API_KEY=sk_atmee_...
MAX_SECONDS=900
PORT=3333
GEMINI_API_KEY=...

# Every app runs in the same server (npm run dev, every app on SITE_PORT). Each app's host
# is the avatarId in its apps/<id>/avatar.json, all in one account: one key for all.
SITE_PORT=5190
# AVATAR_<APP_ID> overrides one app's host, e.g. AVATAR_PRESENCE=... or
# AVATAR_CHESS_OPPONENT=...; AVATAR_DEFAULT serves an app that has neither.
# AVATAR_DEFAULT=
# The avatar-only apps (Waybill, Facecast) render the avatar into the site's own LiveKit room:
# a LiveKit project's URL, key and secret (the secret mints tokens and never leaves the server).
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Their voice: Fish Audio, in each host's own voice (its avatar.json fishVoiceId).
# FISH_API_KEY=
# Crate (dj-booth) searches Spotify as an app (client credentials, no user login):
# a Spotify app's keys from developer.spotify.com/dashboard.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Notch's catalogue images (optional).
# XAI_API_KEY=
