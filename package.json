{
  "name": "atmee-usecase-demos",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Sample apps built on the Atmee Avatar API: five apps on server.js, and fourteen mini-apps from Atmanity/apps on server/.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env --env-file-if-exists=.env.local --clear-screen=false --exclude \"apps/**/*.tsx\" server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start:five": "node server.js"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^4.22.3",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "2.19.1",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.25",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
