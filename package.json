{
  "name": "atmee-usecase-demos",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Sample apps built on the Atmee Avatar API: the original five (classic/) and the mini-apps ported from Atmanity/apps (apps/).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env --clear-screen=false --exclude \"apps/**/*.tsx\" server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file=.env server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "classic": "node --env-file=.env classic/server.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "livekit-client": "^2.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
